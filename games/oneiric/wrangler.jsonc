{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "annapurna-play-oneiric",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "oneiric.play.annapurnaagenticsolutions.com",
      "custom_domain": true
    }
