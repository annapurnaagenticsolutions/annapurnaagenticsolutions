{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "annapurna-play-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-17",
	"workers_dev": false,
	"routes": [
		{
			"pattern": "api.play.annapurnaagenticsolutions.com",
			"custom_domain": true
		}
	],
	"vars": {
		"ALLOWED_ORIGINS": "https://play.annapurnaagenticsolutions.com,https://annapurnaagenticsolutions.com,https://vidya-yantra.play.annapurnaagenticsolutions.com,https://varsha-hollow.play.annapurnaagenticsolutions.com"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "annapurna-play-progress",
			"database_id": "64f92ab1-e469-48c9-84d6-b35f8f2a46fc"
		}
	]
}
