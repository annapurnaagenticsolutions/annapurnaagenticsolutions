    "stickyHeaderAndScrollHardening": true,
    "restrainedFieldBreathing": true
  },
  "experienceContracts": {
    "homeTypographyFrozen": true,
    "labLayoutFrozen": true,
    "selectiveGlassOnly": true,
    "evidenceConflictPreserved": true,
    "privateLocalContinuity": true,
    "reducedMotionFallback": true,
