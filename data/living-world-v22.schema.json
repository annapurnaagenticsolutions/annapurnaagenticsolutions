{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "release",
    "principle",
    "semanticDepth",
    "worldSignatures",
    "interaction",
    "performance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "release": {
      "const": "2.2"
    },
    "principle": {
      "type": "string",
      "minLength": 20
    },
    "worldSignatures": {
      "type": "object",
      "minProperties": 6
    },
    "interaction": {
      "type": "object",
      "properties": {
        "writesSemanticHistory": {
          "const": false
        },
        "writesProductTruth": {
          "const": false
        }
      }
    },
    "performance": {
      "type": "object",
      "properties": {
        "newFramework": {
          "const": false
        },
        "newWebGLContext": {
          "const": false
        },
        "cssDrivenSignatures": {
          "const": true
        }
      }
    }
  }
}
