{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "release",
    "principle",
    "enhancements",
    "integrityContracts",
    "responsiveTargets",
    "performance"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "release": {
      "type": "string",
      "const": "4.3"
    },
    "principle": {
      "type": "string",
      "minLength": 20
    },
    "enhancements": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "integrityContracts": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "responsiveTargets": {
      "type": "object",
      "required": [
        "desktop",
        "tablet",
        "mobile"
      ],
      "additionalProperties": {
        "type": "integer",
        "minimum": 320
      }
    },
    "performance": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
