{
  "$schema": "https://json-schema.org/draft/2020-12/schema.org",
  "type": "object",
  "required": [
    "schemaVersion",
    "release",
    "principle",
    "evaluationPasses",
    "typography",
    "opticalMaterial",
    "continuity",
    "preserves",
    "performance"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "release": {
      "const": "4.0"
    },
    "principle": {
      "type": "string",
      "minLength": 120
    },
    "evaluationPasses": {
      "type": "object",
      "additionalProperties": {
        "const": true
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": {
        "const": true
      }
    },
    "opticalMaterial": {
      "type": "object",
      "additionalProperties": {
        "const": true
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": {
        "const": true
      }
    },
    "preserves": {
      "type": "object",
      "additionalProperties": {
        "const": true
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    }
  }
}
