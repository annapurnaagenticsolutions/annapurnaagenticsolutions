{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "release",
    "principle",
    "home",
    "explore",
    "lab",
    "scope",
    "accessibility"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "release": {
      "const": "3.1"
    },
    "principle": {
      "type": "string",
      "minLength": 50
    },
    "home": {
      "type": "object",
      "required": [
        "legacyRouteSectionRemoved",
        "persistentRailStretchesAcrossStory",
        "journeyUsesSameStage",
        "heroDashBeforeConnectedRemoved",
        "impactWordsUnderlined",
        "journeyMembersStayLegible"
      ],
      "properties": {
        "legacyRouteSectionRemoved": {
          "const": true
        },
        "persistentRailStretchesAcrossStory": {
          "const": true
        },
        "journeyUsesSameStage": {
          "const": true
        },
        "heroDashBeforeConnectedRemoved": {
          "const": true
        },
        "impactWordsUnderlined": {
          "const": false
        },
        "journeyMembersStayLegible": {
          "const": true
        }
      }
    },
    "explore": {
      "type": "object"
    },
    "lab": {
      "type": "object"
    },
    "scope": {
      "type": "object",
      "required": [
        "newFeatureLayer",
        "newFramework",
        "newWebGLContext",
        "truthModelChanged"
      ],
      "properties": {
        "newFeatureLayer": {
          "const": false
        },
        "newFramework": {
          "const": false
        },
        "newWebGLContext": {
          "const": false
        },
        "truthModelChanged": {
          "const": false
        }
      }
    },
    "accessibility": {
      "type": "object"
    }
  }
}
