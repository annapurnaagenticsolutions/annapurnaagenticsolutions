{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://annapurnaagenticsolutions.github.io/annapurna-portal/data/public-history.schema.json",
  "title": "Annapurna Living Lab semantic public-state history",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "sourceLabel", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "sourceLabel": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "capturedAt", "kind", "label", "summary", "semanticDigest", "metrics", "stages", "repositoryTotals"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "capturedAt": { "type": "string", "format": "date-time" },
          "kind": { "type": "string", "enum": ["baseline", "change"] },
          "label": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "semanticDigest": { "type": "string", "minLength": 8 },
          "metrics": {
            "type": "object",
            "required": ["portfolioLines", "websiteDemos", "liveAiTools", "trackedRepositories", "sourcedClaims", "inspectableArtifacts"],
            "properties": {
              "portfolioLines": {"type":"integer","minimum":0},
              "websiteDemos": {"type":"integer","minimum":0},
              "liveAiTools": {"type":"integer","minimum":0},
              "trackedRepositories": {"type":"integer","minimum":0},
              "sourcedClaims": {"type":"integer","minimum":0},
              "inspectableArtifacts": {"type":"integer","minimum":0}
            }, "additionalProperties": false
          },
          "stages": { "type": "object", "additionalProperties": {"type":"string","enum":["research","experiment","prototype","live","mature"]} },
          "repositoryTotals": {
            "type":"object",
            "required":["commits","openIssues","stars","forks"],
            "properties": {
              "commits":{"type":"integer","minimum":0},
              "openIssues":{"type":"integer","minimum":0},
              "stars":{"type":"integer","minimum":0},
              "forks":{"type":"integer","minimum":0}
            }, "additionalProperties": false
          }
        }, "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
